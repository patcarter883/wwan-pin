#!/bin/sh
##########################################################################
# wwan-pin -- give every cellular modem a stable interface name.
#
# WHY THIS EXISTS
#
# The kernel names a modem's netdev (wwan0, wwan1, ...) in PROBE ORDER, so the
# same physical modem comes up under a different name after a replug, or after
# a cold boot in which the modems enumerate the other way round.
# /etc/config/network already binds each modem to a physical USB port:
#
#     config interface 'wwan0'
#         option proto 'modemmanager'
#         option device '/sys/devices/.../usb2/2-1'
#
# but consumers address the modem BY NAME:
#   - rist2rist: a destination's `interface` becomes the daemon argument
#     miface=<name> (librist SO_BINDTODEVICE), and the encoder supplies that
#     name when it selects an output destination via rist2rist.reconcile;
#   - wan-failover: its member list;
#   - SQM: each queue's `interface`.
# When probe order changes, the name refers to the OTHER modem. Nothing errors:
# the traffic simply leaves by the wrong radio. That is the failure this avoids.
#
# WHAT IT DOES
#
# Renames each modem's netdev to the name of the UCI interface that declares its
# USB port, so the name follows the PORT rather than the probe order.
# /etc/config/network remains the one definition of which port carries which
# name -- this script holds no mapping of its own.
#
# A swap (two modems that came up under each other's name) is resolved with a
# two-phase rename through temporary names, because renaming wwan1->wwan0 while
# wwan0 still exists fails with "name in use".
#
# Usage:
#   wwan-pin            reconcile now
#   wwan-pin --dry-run  report what would change, change nothing
#
# Invoked by /etc/hotplug.d/net/30-wwan-pin whenever a netdev appears.
##########################################################################

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

# Overridable so the self-test can drive a synthetic tree (see tests/). Seams
# on purpose: the sysfs scan, the rename command, ModemManager's runtime dir.
SYS_CLASS_NET="${SYS_CLASS_NET:-/sys/class/net}"
SYS_CLASS_USBMISC="${SYS_CLASS_USBMISC:-/sys/class/usbmisc}"
IP="${IP:-ip}"
FUNCTIONS_SH="${FUNCTIONS_SH:-/lib/functions.sh}"
MM_RUNDIR="${MM_RUNDIR:-/var/run/modemmanager}"
MM_INIT="${MM_INIT:-/etc/init.d/modemmanager}"

# NO `set -u` IN THIS SCRIPT, deliberately.
#
# /lib/functions.sh is not `set -u`-safe. It reads $IPKG_INSTROOT unguarded both
# in top-level code --
#     [ -z "$IPKG_INSTROOT" ] && [ -f /lib/config/uci.sh ] && . /lib/config/uci.sh || true
# -- and inside functions we call, config_load among them:
#     [ -n "$IPKG_INSTROOT" ] && return 0
# Under `set -u` either one aborts the shell with "IPKG_INSTROOT: parameter not
# set" and exit status 2, before any rename happens. Putting the source before
# `set -u` only fixes the first; the call into config_load still trips it.
#
# So every variable this script reads is written defensively with ${x:-...}
# instead, which is also what the OpenWrt helper layer expects of its callers.
# shellcheck source=/dev/null
. "$FUNCTIONS_SH"

log() { logger -t wwan-pin "$*" 2>/dev/null; echo "wwan-pin: $*"; }

real_path() { readlink -f "$1" 2>/dev/null; }

# The netdev whose sysfs device sits at, or below, the configured /sys path.
# Prints nothing and returns 1 when no netdev matches: the modem is not present.
netdev_for_device() {
    local want="$1" d real
    for d in "$SYS_CLASS_NET"/*; do
        [ -e "$d/device" ] || continue
        real=$(real_path "$d/device") || continue
        [ -n "$real" ] || continue
        case "$real" in
            "$want"|"$want"/*) basename "$d"; return 0 ;;
        esac
    done
    return 1
}

# A name not currently in use, for the intermediate step. Phase 1 must always be
# able to vacate a name, including when two modems are swapping.
free_temp_name() {
    local n
    for n in wwtmp0 wwtmp1 wwtmp2 wwtmp3; do
        [ -e "$SYS_CLASS_NET/$n" ] || { echo "$n"; return 0; }
    done
    return 1
}

# ---------------------------------------------------------------------------
# ModemManager's on-disk state -- reconciles it with the names on disk.
#
# Renaming a netdev invalidates state ModemManager keeps in MM_RUNDIR, both of
# it keyed by netdev NAME:
#
#   events.cache  "action,devname,subsystem,syspath"  REPLAYED on every start
#   cdcwdm.cache  "<netdev> <cdc-wdm>"                the control-port map
#
# MM's own net hotplug handler is numbered 25 and this script 30, so on a fresh
# add MM records the PRE-RENAME name first. The rename then leaves a cache entry
# pointing at a path that no longer exists. MM replays that entry on every start
# and never expires it, so the modem disappears from `mmcli -L`
# ("device net/wwan0 not found") and its interface never comes up -- while the
# USB device, its driver and /dev/cdc-wdm0 are all perfectly healthy.
#
# Restarting ModemManager does NOT clear this: the stale cache is the cause and
# the restart is what replays it. That is the trap -- it looks like a modem
# problem and is a cache problem. (Observed live: a modem was reported
# "No modems were found" with `unlock retries: sim-pin2`, which reads as a
# SIM-PIN fault and is not one.)
#
# So drop dead entries, make sure today's mapping is present, and if MM is
# already running make it re-read the corrected files. Entries belonging to
# other devices (serial ttys, other modems) are preserved -- this filters, it
# does not rebuild from scratch.
# ---------------------------------------------------------------------------

# The cdc-wdm control port that sits beside a netdev in sysfs.
cdcwdm_for_netdev() {
    local dev="$1" base d
    base=$(real_path "$SYS_CLASS_NET/$dev/device") || return 1
    [ -n "$base" ] || return 1
    for d in "$base"/usbmisc/cdc-wdm*; do
        [ -e "$d" ] || continue
        basename "$d"
        return 0
    done
    return 1
}

# Every cellular netdev currently present.
modem_netdevs() {
    local d
    for d in "$SYS_CLASS_NET"/wwan* "$SYS_CLASS_NET"/wwx*; do
        [ -e "$d" ] || continue
        basename "$d"
    done
}

# Rewrite $1 as $2's content, keeping the original in place for readers.
replace_file() {
    [ -n "${1:-}" ] && [ -f "${2:-}" ] || return 0
    cat "$2" > "$1" 2>/dev/null
    rm -f "$2"
}

mm_cache_reconcile() {
    local f tmp line path dev wdm

    [ -d "$MM_RUNDIR" ] || return 0

    # 1. events.cache -- drop entries whose sysfs path has gone. The syspath is
    #    the LAST field, so strip to the final comma rather than counting.
    f="$MM_RUNDIR/events.cache"
    if [ -f "$f" ]; then
        tmp="$f.wwan-pin.$$"
        : > "$tmp"
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            path="${line##*,}"
            if [ -n "$path" ] && [ ! -e "$path" ]; then
                log "dropped dead ModemManager event: $line"
                continue
            fi
            grep -qxF "$line" "$tmp" 2>/dev/null || printf '%s\n' "$line" >> "$tmp"
        done < "$f"
        replace_file "$f" "$tmp"
    fi

    # 2. cdcwdm.cache -- keep only live netdevs, then ensure the mapping for
    #    every modem that is actually present.
    f="$MM_RUNDIR/cdcwdm.cache"
    if [ -f "$f" ]; then
        tmp="$f.wwan-pin.$$"
        : > "$tmp"
        while read -r dev wdm; do
            [ -n "$dev" ] || continue
            if [ ! -e "$SYS_CLASS_NET/$dev" ]; then
                log "dropped dead ModemManager cdcwdm entry: $dev"
                continue
            fi
            grep -qxF "$dev $wdm" "$tmp" 2>/dev/null || printf '%s %s\n' "$dev" "$wdm" >> "$tmp"
        done < "$f"
        for dev in $(modem_netdevs); do
            wdm=$(cdcwdm_for_netdev "$dev") || continue
            grep -q "^$dev " "$tmp" 2>/dev/null || printf '%s %s\n' "$dev" "$wdm" >> "$tmp"
        done
        replace_file "$f" "$tmp"
    fi

    # 3. Ensure an event for every modem that is actually present. Pruning
    #    alone is not enough: when MM's cache has been emptied -- or the modem
    #    changed USB composition AFTER the rename, so the pin ran while there
    #    was no MBIM port to see -- there is nothing left to replay and MM still
    #    reports no modem however correct the mapping looks. The syspaths are
    #    read from sysfs rather than assumed, and MM's own format is
    #    "action,devname,subsystem,syspath".
    f="$MM_RUNDIR/events.cache"
    [ -f "$f" ] || : > "$f"
    for dev in $(modem_netdevs); do
        net=$(real_path "$SYS_CLASS_NET/$dev")
        if [ -n "$net" ] && ! grep -qxF "add,$dev,net,$net" "$f" 2>/dev/null; then
            printf 'add,%s,net,%s\n' "$dev" "$net" >> "$f"
            log "added ModemManager event: add,$dev,net,$net"
        fi
        wdm=$(cdcwdm_for_netdev "$dev") || continue
        wdmp=$(real_path "$SYS_CLASS_USBMISC/$wdm")
        [ -n "$wdmp" ] || continue
        if ! grep -qxF "add,$wdm,usbmisc,$wdmp" "$f" 2>/dev/null; then
            printf 'add,%s,usbmisc,%s\n' "$wdm" "$wdmp" >> "$f"
            log "added ModemManager event: add,$wdm,usbmisc,$wdmp"
        fi
    done

    # 4. If ModemManager is already up it is holding the stale state in memory
    #    and only reads the cache at start, so have it start again. At boot this
    #    is usually a no-op -- MM has not started yet and will replay the
    #    corrected cache itself.
    if [ -x "$MM_INIT" ] && "$MM_INIT" running >/dev/null 2>&1; then
        log "restarting ModemManager so it re-reads its corrected cache"
        "$MM_INIT" restart >/dev/null 2>&1
    fi
}

# --- the mapping the config declares --------------------------------------
#
# "name devpath" per line. Paths and interface names contain no spaces, so a
# space is a safe field separator and avoids tab handling in heredocs.

TARGETS=""

collect_target() {
    local cfg="$1" dev
    config_get dev "$cfg" device
    # Only an interface bound to a filesystem port path is in scope; one bound
    # to a bare name is not ours to rename. Any absolute path is accepted --
    # the scan below only ever walks "$SYS_CLASS_NET", so a path that is not
    # really a sysfs device simply matches nothing. Requiring a literal /sys
    # prefix here would also make the logic untestable off-device.
    case "$dev" in
        /*) TARGETS="${TARGETS}${cfg} ${dev}
" ;;
    esac
}

config_load network
config_foreach collect_target interface

# Even with nothing to rename, ModemManager may still be holding a stale entry
# from an earlier rename, so reconcile before leaving.
if [ -z "$TARGETS" ]; then
    [ "$DRY_RUN" = 1 ] && log "no modem is bound to a port path; nothing to pin"
    [ "$DRY_RUN" = 1 ] || mm_cache_reconcile
    exit 0
fi

# --- what has to change ---------------------------------------------------
#
# "actual target" per line. A modem with no netdev is skipped: absent is normal.

CHANGES=""

while read -r name dev; do
    [ -n "${name:-}" ] || continue
    actual=$(netdev_for_device "$dev") || continue
    [ "$actual" = "$name" ] && continue
    CHANGES="${CHANGES}${actual} ${name}
"
done <<TARGETS_EOF
$TARGETS
TARGETS_EOF

if [ -z "$CHANGES" ]; then
    if [ "$DRY_RUN" = 1 ]; then
        log "all modem names already match the config"
    else
        mm_cache_reconcile
    fi
    exit 0
fi

if [ "$DRY_RUN" = 1 ]; then
    while read -r actual target; do
        [ -n "${actual:-}" ] || continue
        log "would rename ${actual} -> ${target}"
    done <<CHANGES_EOF
$CHANGES
CHANGES_EOF
    exit 0
fi

# --- apply: phase 1 vacates every name, phase 2 assigns them --------------

MOVED=""
rc=0

while read -r actual target; do
    [ -n "${actual:-}" ] || continue
    tmp=$(free_temp_name) || { log "no free temporary name; giving up"; rc=1; break; }
    if $IP link set dev "$actual" name "$tmp" 2>/dev/null; then
        MOVED="${MOVED}${tmp} ${target}
"
        log "vacated ${actual} (-> ${tmp}, will become ${target})"
    else
        log "could not rename ${actual} out of the way"
        rc=1
    fi
done <<CHANGES_EOF
$CHANGES
CHANGES_EOF

while read -r tmp target; do
    [ -n "${tmp:-}" ] || continue
    if $IP link set dev "$tmp" name "$target" 2>/dev/null; then
        log "pinned ${target} to its configured port"
    else
        log "FAILED to rename ${tmp} -> ${target}; it is left as ${tmp}"
        rc=1
    fi
done <<MOVED_EOF
$MOVED
MOVED_EOF

# The renames above are what invalidate ModemManager's cache, so this is not
# optional cleanup -- without it a renamed modem is invisible to MM until
# someone edits its cache by hand.
mm_cache_reconcile

exit $rc
